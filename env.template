# ═══════════════════════════════════════════════════════════════════
# CodePilot V14 Configuration
# ═══════════════════════════════════════════════════════════════════

# ── API Key (base64 encoded to prevent GitHub auto-revocation) ──
# App decodes this automatically at startup
# Get your key from https://aistudio.google.com then base64 encode it
GEMINI_API_KEY_ENC=YOUR_BASE64_ENCODED_API_KEY_HERE

# ── Option 2: Cookie-based Web API (unlimited, no rate limits) ──
# Run: python setup_gemini.py to set your cookies.
GEMINI_1PSID=YOUR_1PSID_COOKIE_HERE
GEMINI_1PSIDTS=YOUR_1PSIDTS_COOKIE_HERE

# ── Model Settings ──────────────────────────────────────────────
GEMINI_MODEL=pro_first
GEMINI_MAX_ATTEMPTS=5
GEMINI_MODEL_TRIES=3
GEMINI_TIMEOUT=180
GEMINI_ATTEMPT_TIMEOUT=180
GEMINI_INIT_TIMEOUT=30
GEMINI_REINIT_PAUSE=1
GEMINI_MAX_BACKOFF=10
GEMINI_WATCHDOG_TIMEOUT=180

# ── Typing Speed ────────────────────────────────────────────────
# WPM (words per minute). 30=slow, 60=fast, 100=very fast, 200=max
WPM=200
# Per-character delay (seconds). Only used if WPM is 0.
TYPE_INTERVAL=0.015
# Fix editors that auto-close brackets {}, (), [].
FIX_AUTO_CLOSE=true

# ── Other Settings ──────────────────────────────────────────────
RESULT_DELAY=10
CHUNK_AMOUNT=1
CHUNK_TYPE=chars

# ── Proxy (college/corporate networks) ──────────────────────────
# If you're behind a proxy, set these. Examples:
#   http://proxy.college.edu:8080
#   http://username:password@proxy.college.edu:3128
#   socks5://proxy.college.edu:1080
HTTP_PROXY=
HTTPS_PROXY=
